# ==============================================================================
# LoanAssist - Backend Environment Configuration Template
# Copy this file to '.env' in this directory and populate with your secret values.
# ==============================================================================

# Django Secret Key (Generate a strong 50+ character random secret for production)
SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated list of domain names or IP addresses)
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,api.loanassist.com,your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Fast SQLite for local development
USE_SQLITE=True

# Option 2: Full Database Connection URL (Recommended for Cloud Hosting / Render / Railway / Supabase / Neon)
# Example: DATABASE_URL=postgresql://user:password@hostname:5432/dbname
# DATABASE_URL=

# Option 3: Individual PostgreSQL connection parameters (Used if DATABASE_URL is not provided and USE_SQLITE=False)
DB_ENGINE=postgresql
DB_NAME=loanassist_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Security & CORS Settings
# ==============================================================================
# Comma-separated list of allowed frontend origins that can make API requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to True only for local development if you need to allow all origins
CORS_ALLOW_ALL_ORIGINS=False

# JWT Token Secret (Optional: defaults to SECRET_KEY if not specified)
# JWT_SECRET_KEY=your_jwt_signing_key_here
